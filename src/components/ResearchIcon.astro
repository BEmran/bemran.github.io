---
const { id = '' } = Astro.props;
---
<span class="research-line-icon" aria-hidden="true">
  {id.includes('advanced') && <svg viewBox="0 0 48 48" fill="none"><rect x="11" y="13" width="26" height="22" rx="2"/><path d="M4 24h7m26 0h7M24 6v7m0 22v7M17 18h14v12H17z"/></svg>}
  {id.includes('learning') && <svg viewBox="0 0 48 48" fill="none"><circle cx="10" cy="13" r="3"/><circle cx="10" cy="35" r="3"/><circle cx="24" cy="9" r="3"/><circle cx="24" cy="24" r="3"/><circle cx="24" cy="39" r="3"/><circle cx="38" cy="15" r="3"/><circle cx="38" cy="33" r="3"/><path d="M13 13l8-3m-8 4 8 8m-8 12 8-8m-8 9 8 3m6-28 8 4m-8 9 8-7m-8 9 8 7m-8 7 8-4"/></svg>}
  {id.includes('autonomous') && <svg viewBox="0 0 48 48" fill="none"><path d="M10 20h28v12H10zM15 20l3-7h12l3 7M20 13V9h8v4"/><circle cx="17" cy="35" r="4"/><circle cx="33" cy="35" r="4"/><path d="M14 25h5m10 0h5M24 20v12"/></svg>}
  {id.includes('intelligent') && <svg viewBox="0 0 48 48" fill="none"><path d="M10 36h28M14 34V25m7 9V19m7 15V13m7 21V8"/><path d="m12 19 8-7 7 4 10-11"/><circle cx="12" cy="19" r="2"/><circle cx="20" cy="12" r="2"/><circle cx="27" cy="16" r="2"/><circle cx="37" cy="5" r="2"/></svg>}
</span>
