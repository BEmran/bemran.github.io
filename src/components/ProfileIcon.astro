---
const { name } = Astro.props;
---
<span class={`profile-icon profile-icon-${name}`} aria-hidden="true">
  {name === 'linkedin' && (
    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" fill="currentColor"/><path d="M7.2 10v7M7.2 7.2v.1M10.6 17v-7m0 3.1c.8-1.2 1.9-1.8 3.2-1.8 2 0 3.2 1.3 3.2 3.8V17" stroke="white" stroke-width="1.8" stroke-linecap="round"/></svg>
  )}
  {name === 'scholar' && (
    <svg viewBox="0 0 24 24" fill="none"><path d="M2.8 9.3 12 4l9.2 5.3L12 14.6 2.8 9.3Z" fill="currentColor"/><path d="M6.2 11.3V16c2.9 2.4 8.7 2.4 11.6 0v-4.7M20 10v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  )}
  {name === 'orcid' && <span class="profile-letter profile-letter-orcid">iD</span>}
  {name === 'scopus' && <span class="profile-letter profile-letter-scopus">Sc</span>}
  {name === 'aus' && (
    <span class="aus-mini-mark"><span class="aus-dome">⌒</span><strong>AUS</strong></span>
  )}
</span>
