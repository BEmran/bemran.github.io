---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const items = (await getCollection('research')).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title="Research | Bara Emran">
  <section class="page-hero shell"><span class="eyebrow">RESEARCH</span><h1>Research Areas</h1><p>Research themes connecting nonlinear control, safe learning, data-driven methods, and experimental autonomous robotic systems.</p></section>
  <section class="section shell listing-grid">
    {items.map((item) => <a class="listing-card" href={`/research/${item.id}/`}><h2>{item.data.title}</h2><p>{item.data.shortDescription}</p><span>Explore →</span></a>)}
  </section>
</BaseLayout>
