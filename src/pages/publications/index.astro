---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const items = (await getCollection('publications')).sort((a,b)=>b.data.year-a.data.year);
---
<BaseLayout title="Publications | Your Name">
  <section class="page-hero shell"><span class="eyebrow">PUBLICATIONS</span><h1>Publications</h1><p>Journal, conference, and workshop publications linked to research areas and projects.</p></section>
  <section class="section shell"><ol class="publication-list publication-page">{items.map((entry)=><li><h3>{entry.data.title}</h3><p>{entry.data.authors.join(', ')}</p><p><em>{entry.data.venue}</em>, {entry.data.year}</p><div class="mini-links">{entry.data.paperUrl&&<a href={entry.data.paperUrl}>Paper</a>}{entry.data.pdfUrl&&<a href={entry.data.pdfUrl}>PDF</a>}{entry.data.codeUrl&&<a href={entry.data.codeUrl}>Code</a>}{entry.data.videoUrl&&<a href={entry.data.videoUrl}>Video</a>}</div></li>)}</ol></section>
</BaseLayout>
